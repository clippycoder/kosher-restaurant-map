{
  "name": "kosher-map-submissions",
  "private": true,
  "type": "module",
  "description": "Community submissions API for the kosher restaurant map (Cloudflare Worker + D1)",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "dev": "wrangler dev",
    "migrate:local": "wrangler d1 migrations apply kosher-map-submissions --local",
    "migrate:remote": "wrangler d1 migrations apply kosher-map-submissions --remote",
    "deploy": "wrangler deploy",
    "moderate": "node scripts/moderate.mjs"
  }
}
